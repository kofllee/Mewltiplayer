{
  "schemaVersion": 1,
  "id": "mewltiplayer",
  "version": "${version}",
  "name": "Mewltiplayer",
  "description": "Share Minecraft worlds with friends using Tailcat-powered connections.",
  "authors": ["Mewltiplayer contributors"],
  "license": "MIT",
  "environment": "*",
  "mixins": [
    {"config": "mewltiplayer.client.mixins.json", "environment": "client"}
  ],
  "entrypoints": {
    "main": ["dev.mewltiplayer.fabric.MewltiplayerMod"],
    "client": ["dev.mewltiplayer.fabric.MewltiplayerClient"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
