{
  "schemaVersion": 1,
  "id": "mewltiplayer",
  "version": "${version}",
  "name": "Mewltiplayer",
  "icon": "assets/mewltiplayer/icon.png",
  "description": "Play Minecraft with friends without port forwarding or a separate VPN. Powered by Tailcat.",
  "authors": ["apathee"],
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/kofllee/Mewltiplayer",
    "sources": "https://github.com/kofllee/Mewltiplayer",
    "issues": "https://github.com/kofllee/Mewltiplayer/issues"
  },
  "environment": "*",
  "mixins": [
    {"config": "mewltiplayer.client.mixins.json", "environment": "client"}
  ],
  "entrypoints": {
    "main": ["dev.mewltiplayer.fabric.MewltiplayerMod"],
    "client": ["dev.mewltiplayer.fabric.MewltiplayerClient"],
    "modmenu": ["dev.mewltiplayer.fabric.MewModMenu"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
